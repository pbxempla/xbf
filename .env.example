# Better Auth Configuration
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
BACKEND_API_URL=http://localhost:8000/api/v1
AUTH_BRIDGE_SECRET=
# OpenRouter is called only by the FastAPI backend (OPENROUTER_API_KEY lives in backend .env).

# File Upload Security Configuration
# NEXT_PUBLIC_* values are public browser configuration, not secrets.
NEXT_PUBLIC_ALLOWED_FILE_EXTENSIONS=.csv,.xls,.xlsx
NEXT_PUBLIC_MAX_FILE_SIZE_MB=100

# Optional "import from Google Drive / Dropbox" buttons on the upload page. A button only
# appears when its values are set. These are public identifiers, not secrets (see README).
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_API_KEY=
NEXT_PUBLIC_GOOGLE_APP_ID=
NEXT_PUBLIC_DROPBOX_APP_KEY=

# Database
DATABASE_URL=

# Port for `npm run dev` / `npm start` (read from this file by scripts/run-next.mjs).
# To change it: edit PORT, then set BETTER_AUTH_URL and NEXT_PUBLIC_APP_URL above and
# FRONTEND_URL in the backend .env to the same origin, run `npm run build`, then `npm start`.
PORT=3000
# NEXT_PUBLIC_* values are exposed to the browser and embedded at build time.

# Google Workspace SMTP (smtp.gmail.com; use a Workspace app password)
XEMPLA_MAIL_USERNAME=
XEMPLA_MAIL_PASSWORD=
XEMPLA_MAIL_FROM=
XEMPLA_MAIL_SERVER=smtp.gmail.com
XEMPLA_MAIL_PORT=587
XEMPLA_MAIL_TLS=
XEMPLA_MAIL_SSL=false
XEMPLA_USE_CREDENTIALS=true
