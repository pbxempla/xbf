# Better Auth Configuration
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Database
DATABASE_URL=

# Set PORT in the hosting environment (Next.js does not load it from .env).
# NEXT_PUBLIC_* values are embedded at build time.

# Google Workspace SMTP (smtp.gmail.com; use a Workspace app password)
XEMPLA_MAIL_USERNAME=
XEMPLA_MAIL_PASSWORD=
XEMPLA_MAIL_FROM=
XEMPLA_MAIL_SERVER=smtp.gmail.com
XEMPLA_MAIL_PORT=587
XEMPLA_MAIL_TLS=
XEMPLA_MAIL_SSL=false
XEMPLA_USE_CREDENTIALS=true
